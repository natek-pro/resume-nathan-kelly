{
  "name": "resume-pdf",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "browser:install": "playwright install chromium --only-shell",
    "check:source": "node scripts/check-source.mjs",
    "portable": "node scripts/export-portable-resume.mjs",
    "check:portable": "node scripts/export-portable-resume.mjs --check",
    "check:pdf": "python3 scripts/check-export.py",
    "build": "npm run readme && npm run catalog && npm run build:web && npm run export -- resume_source.md output/pdf/drafts/resume.pdf",
    "check": "npm run check:source && npm run check:catalog && npm run check:portable && npm run check:pdf -- resume_source.md output/pdf/drafts/resume.pdf && npm run check:fonts",
    "export": "node scripts/export-resume.mjs",
    "snapshot": "node scripts/snapshot-resume.mjs",
    "check:fonts": "python3 scripts/check-fonts.py",
    "build:encrypted": "python3 scripts/build-encrypted.py",
    "test": "python3 -m unittest discover -s tests && npm run test:catalog",
    "test:catalog": "node --test tests/test_bullet_catalog.mjs",
    "catalog": "npm run check:source && node scripts/generate-bullet-catalog.mjs",
    "check:catalog": "node scripts/generate-bullet-catalog.mjs --check",
    "readme": "npm run check:source && node scripts/generate-readme.mjs",
    "check:readme": "node scripts/generate-readme.mjs --check",
    "build:web": "npm run check:source && node scripts/generate-web.mjs",
    "check:web": "node scripts/check-web.mjs"
  },
  "dependencies": {
    "marked": "15.0.12",
    "playwright": "1.62.1"
  }
}
