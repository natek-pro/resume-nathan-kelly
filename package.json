{
  "name": "resume-pdf",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "browser:install": "playwright install chromium --only-shell",
    "check:source": "node scripts/check-source.mjs",
    "check:pdf": "python3 scripts/check-export.py",
    "build": "npm run check:source && npm run export -- README.md output/pdf/drafts/resume.pdf",
    "check": "npm run check:source && npm run check:pdf -- README.md output/pdf/drafts/resume.pdf && npm run check:fonts",
    "export": "node scripts/export-resume.mjs",
    "snapshot": "node scripts/snapshot-resume.mjs",
    "check:fonts": "python3 scripts/check-fonts.py",
    "build:encrypted": "python3 scripts/build-encrypted.py",
    "test": "python3 -m unittest discover -s tests"
  },
  "dependencies": {
    "marked": "15.0.12",
    "playwright": "1.62.1"
  }
}
